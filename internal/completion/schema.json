{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "checks",
    "remaining_work",
    "approval_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": ["done", "partial", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "remaining_work": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    }
  }
}
