{
  "description": "Bind DoneThen controller grants, observe single-session and multi-session Stop targets, and cancel safely on later activity without steering Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__done_then__(arm|finish|pause|cancel)$",
        "hooks": [
          {
            "type": "command",
            "command": "donethen hook",
            "commandWindows": "donethen.exe hook",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "donethen hook",
            "commandWindows": "donethen.exe hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "donethen hook",
            "commandWindows": "donethen.exe hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "donethen hook",
            "commandWindows": "donethen.exe hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
